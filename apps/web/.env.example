# Postgres (Neon). Sin esta variable no hay cuentas ni tabla: solo se juega como invitado.
DATABASE_URL=
# Secreto para firmar sesiones (el mismo en apps/server). Genera uno con: openssl rand -base64 32
AUTH_SECRET=
# Servidor de partidas (Socket.IO)
NEXT_PUBLIC_GAME_SERVER_URL=http://localhost:4000
# Permite jugar sin cuenta (el progreso del invitado no se guarda).
NEXT_PUBLIC_ALLOW_GUESTS=true
