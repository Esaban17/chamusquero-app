# Supabase: Project Settings > API (clave publicable, nunca la secreta)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# URL pública del sitio (respaldo para los enlaces mágicos)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Servidor de partidas (Socket.IO)
NEXT_PUBLIC_GAME_SERVER_URL=http://localhost:4000
# Permite jugar sin cuenta. En producción, déjalo en false.
NEXT_PUBLIC_ALLOW_GUESTS=true
