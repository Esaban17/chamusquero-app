PORT=4000
# Origen de la web (CORS). Varios separados por coma.
WEB_ORIGIN=http://localhost:3000
# Postgres (Neon). Sin esta variable el servidor guarda todo en memoria (solo para desarrollo).
DATABASE_URL=
# El mismo secreto que AUTH_SECRET de apps/web: verifica las sesiones de los jugadores con cuenta.
AUTH_SECRET=
# Permite jugar sin cuenta (útil en desarrollo).
ALLOW_GUESTS=true
# Milisegundos esperando rival humano antes de jugar contra un bot.
BOT_WAIT_MS=15000
