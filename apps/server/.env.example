PORT=4000
# Origen de la web (CORS). Varios separados por coma.
WEB_ORIGIN=http://localhost:3000
# Supabase. Sin estas variables el servidor guarda todo en memoria (solo para desarrollo).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Clave secreta: solo en el servidor, nunca en la web.
SUPABASE_SECRET_KEY=
# Permite jugar sin cuenta (útil en desarrollo).
ALLOW_GUESTS=true
# Milisegundos esperando rival humano antes de jugar contra un bot.
BOT_WAIT_MS=15000
