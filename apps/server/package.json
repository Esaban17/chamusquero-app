{
  "name": "@chamusqueros/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --external:socket.io --external:@neondatabase/serverless --outfile=dist/index.mjs",
    "start": "node --env-file-if-exists=.env dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-timeout=30000 src/*.test.ts"
  },
  "dependencies": {
    "@chamusqueros/shared": "*",
    "@neondatabase/serverless": "^1.2.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "esbuild": "^0.25.0",
    "socket.io-client": "^4.8.1",
    "typescript": "^5"
  }
}
